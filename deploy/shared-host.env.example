# Shared-host staging: the app does NOT bind 80/443.
# Copy to deploy/shared-host.env on the Oracle host and keep it out of Git.
POSTGRES_DB=lct
POSTGRES_USER=lct
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Default is loopback-only for a reverse proxy on the same host.
# If the trusted reverse proxy is on another host, bind to the host/tailnet address
# and restrict network/firewall access to that proxy only.
LCT_BIND_ADDRESS=127.0.0.1
LCT_PORT=8110
