APP_ENV=development
APP_PORT=8000
DINOV2_DEVICE=
# TLC_PROFILES_PATH=config/tlc_profiles.json

# Local development can stay on SQLite.
DATABASE_URL=sqlite:///runtime/lct.db

# Staging/production may omit DATABASE_URL and use these instead.
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=lct
# DB_USER=lct
# DB_PASSWORD=replace-with-secret

STORAGE_BACKEND=filesystem
STORAGE_ROOT=/app/runtime/storage
